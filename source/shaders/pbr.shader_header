#ifndef PBR
#define PBR

#include "math.shader_header"

const float MIN_ROUGHNESS     = 0.005;
const float SPECULAR_NONMETAL = 0.04;

#define fresnelComponent(value) pow5(1.0 - (value))

// https://seblagarde.wordpress.com/wp-content/uploads/2015/07/course_notes_moving_frostbite_to_pbr_v32.pdf
vec3 diffuseBurley(vec3 diffuse_color, float roughness, float NdotV, float NdotL, float LdotH) {
    const float energy_bias   = 0.5 * roughness;
    const float energy_factor = lerp(1.0, 1.0 / 1.51, roughness);

    const float FD90 = energy_bias + 2.0 * roughness * pow2(LdotH);
    const vec2  FdVL = 1.0 + (FD90 - 1.0) * fresnelComponent(vec2(NdotV, NdotL));

    return diffuse_color * (FdVL.x * FdVL.y) * energy_factor * INV_PI;
}

// https://www.jcgt.org/published/0003/02/03/paper.pdf
// https://www.graphics.cornell.edu/~bjw/microfacetbsdf.pdf
float NDF(float NdotH, float ggx_alpha) {
    const float ggx_alpha_2 = pow2(ggx_alpha);
    const float denominator = (ggx_alpha_2 - 1.0) * pow2(NdotH) + 1.0;

    // Epsilon prevents random sparkles due to zero or "near-zero" division
    return ggx_alpha_2 / max(pow2(denominator), BRDF_EPSILON);
}

// https://www.jcgt.org/published/0003/02/03/paper.pdf
// https://www.graphics.cornell.edu/~bjw/microfacetbsdf.pdf
float VF(float NdotL, float NdotV, float ggx_alpha) {
    const float invAlpha = 1.0 - ggx_alpha;
    const float lambdaV  = NdotL * (NdotV * invAlpha + ggx_alpha);
    const float lambdaL  = NdotV * (NdotL * invAlpha + ggx_alpha);

    // Epsilon prevents random sparkles due to zero or "near-zero" division
    return 0.5 / max(lambdaV + lambdaL, BRDF_EPSILON);
}

// https://seblagarde.wordpress.com/wp-content/uploads/2015/07/course_notes_moving_frostbite_to_pbr_v32.pdf
vec3 fresnelSchlick(vec3 specular_color, float LdotH) {
    const vec3  f0  = specular_color;
    const float f90 = min(50.0 * dot(f0, vec3(0.33, 0.33, 0.33)), 1.0);
    return f0 + (f90 - f0) * fresnelComponent(LdotH);
}

vec3 calculateBRDF(vec3 L, vec3 V, vec3 N, vec3 albedo, float metalness, float roughness) {
    roughness = max(roughness, MIN_ROUGHNESS);

    const vec3 diffuse_color  = albedo * (1.0 - metalness);
    const vec3 specular_color = lerp(min(albedo, SPECULAR_NONMETAL), albedo, metalness);

    const vec3 H = safeNormalize(L + V, N);

    const float NdotV = clamp(abs(dot(N, V)), BRDF_EPSILON, 1.0); // epsilon "avoids artifacts" (c) Frostbite
    const float NdotL = saturate(dot(N, L));
    const float NdotH = saturate(dot(N, H));
    const float LdotH = saturate(dot(L, H));

    const vec3 diffuse = diffuseBurley(diffuse_color, roughness, NdotV, NdotL, LdotH);

    const float ggx_alpha = pow2(roughness);
    const vec3  specular  = NDF(NdotH, ggx_alpha) * VF(NdotL, NdotV, ggx_alpha) * fresnelSchlick(specular_color, LdotH);

    return (diffuse + specular) * NdotL;
}

float toneMappingUncharted2(float v) {
    const float COEFF_A = 0.15;
    const float COEFF_B = 0.50;
    const float COEFF_C = 0.10;
    const float COEFF_D = 0.20;
    const float COEFF_E = 0.02;
    const float COEFF_F = 0.30;

    const float COEFF_CB = COEFF_C * COEFF_B;
    const float COEFF_DE = COEFF_D * COEFF_E;
    const float COEFF_DF = COEFF_D * COEFF_F;
    const float COEFF_EF = COEFF_E / COEFF_F;

    return ((v * (COEFF_A * v + COEFF_CB) + COEFF_DE) / (v * (COEFF_A * v + COEFF_B) + COEFF_DF)) - COEFF_EF;
}

vec3 toneMappingUncharted2(vec3 v) {
    const float COEFF_A = 0.15;
    const float COEFF_B = 0.50;
    const float COEFF_C = 0.10;
    const float COEFF_D = 0.20;
    const float COEFF_E = 0.02;
    const float COEFF_F = 0.30;

    const float COEFF_CB = COEFF_C * COEFF_B;
    const float COEFF_DE = COEFF_D * COEFF_E;
    const float COEFF_DF = COEFF_D * COEFF_F;
    const float COEFF_EF = COEFF_E / COEFF_F;

    return ((v * (COEFF_A * v + COEFF_CB) + COEFF_DE) / (v * (COEFF_A * v + COEFF_B) + COEFF_DF)) - COEFF_EF;
}

#endif
